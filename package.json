{
  "name": "apex-line",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --trace off",
    "assets:check": "node scripts/check-assets.mjs",
    "assets:optimize": "node scripts/optimize-assets.mjs"
  },
  "dependencies": {
    "postprocessing": "6.36.4",
    "three": "0.169.0"
  },
  "overrides": {
    "@gltf-transform/extensions": "4.1.1",
    "@gltf-transform/functions": "4.1.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.1.1",
    "@gltf-transform/core": "4.1.1",
    "@playwright/test": "1.48.2",
    "@types/node": "22.9.0",
    "@types/three": "0.169.0",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.5"
  }
}
